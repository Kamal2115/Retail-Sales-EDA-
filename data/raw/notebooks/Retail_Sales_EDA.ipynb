# %% [markdown]
# # Retail Sales Dataset — Exploratory Data Analysis (EDA)
# 
# ## Objective
# 
# Perform a thorough Exploratory Data Analysis on the retail sales dataset to uncover:
# 
# - Sales patterns and trends
# - Customer demographic behaviour
# - Product and category performance
# - Relationships between numerical variables
# - Non-obvious business insights
# - Actionable recommendations for improving business performance
# 
# ## Technology Stack
# 
# - Python
# - Pandas
# - NumPy
# - Matplotlib
# - Seaborn
# - Jupyter Notebook#
# 
# %%
# ============================================================
# 1. IMPORT LIBRARIES
# ============================================================

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns
from IPython.display import display

# Display settings
pd.set_option("display.max_columns", None)
pd.set_option("display.max_rows", 100)

# Plotting style
sns.set_theme(style="whitegrid")

print("Libraries imported successfully.")
# %%
# ============================================================
# 2. LOAD DATASET
# ============================================================

df = pd.read_csv(r"C:\Users\nayan\OneDrive\Desktop\Infosis\L1T1\L1T1_Dataset\retail_sales_dataset.csv")

print("Dataset loaded successfully.")
print(f"Number of rows    : {df.shape[0]}")
print(f"Number of columns : {df.shape[1]}")
# %%
# ============================================================
# 3. INITIAL DATASET INSPECTION
# ============================================================

print("=" * 60)
print("DATASET SHAPE")
print("=" * 60)

print(f"Rows    : {df.shape[0]}")
print(f"Columns : {df.shape[1]}")

print("\n" + "=" * 60)
print("COLUMN NAMES")
print("=" * 60)

print(df.columns.tolist())

print("\n" + "=" * 60)
print("FIRST 5 ROWS")
print("=" * 60)

display(df.head())

print("\n" + "=" * 60)
print("LAST 5 ROWS")
print("=" * 60)

display(df.tail())
# %%
# ============================================================
# 4. COLUMN DATA TYPES
# ============================================================

print("=" * 60)
print("DATA TYPES")
print("=" * 60)

display(df.dtypes.to_frame(name="Data Type"))
# %%
# ============================================================
# 5. DATASET INFORMATION
# ============================================================

print("=" * 60)
print("DATASET INFO")
print("=" * 60)

df.info()
# %%
# ============================================================
# 6. NULL / MISSING VALUE CHECK
# ============================================================

missing_values = df.isnull().sum()

missing_percentage = (
    df.isnull().sum() / len(df) * 100
).round(2)

missing_summary = pd.DataFrame({
    "Missing Values": missing_values,
    "Missing Percentage": missing_percentage
})

display(missing_summary)

if missing_values.sum() == 0:
    print("\nNo missing values found in the dataset.")
else:
    print("\nMissing values are present and should be investigated.")
# %%
# ============================================================
# 7. DUPLICATE CHECK
# ============================================================

duplicate_count = df.duplicated().sum()

print(f"Number of duplicate rows: {duplicate_count}")

if duplicate_count == 0:
    print("No duplicate rows found.")
else:
    print("Duplicate rows should be investigated.")
# %%
# ============================================================
# 8. UNIQUE VALUE ANALYSIS
# ============================================================

unique_summary = pd.DataFrame({
    "Column": df.columns,
    "Unique Values": [df[col].nunique() for col in df.columns]
})

display(unique_summary)
# %%
# ============================================================
# 9. DATE CONVERSION
# ============================================================

df["Date"] = pd.to_datetime(df["Date"], errors="coerce")

print("Date column converted to datetime.")

print("\nDate range:")
print("Start Date:", df["Date"].min())
print("End Date  :", df["Date"].max())
# %%
# ============================================================
# 11. DESCRIPTIVE STATISTICS
# ============================================================

numeric_columns = df.select_dtypes(include=np.number).columns

print("Numerical Columns:")
print(numeric_columns.tolist())

# Mean
mean_values = df[numeric_columns].mean()

# Median
median_values = df[numeric_columns].median()

# Mode
mode_values = df[numeric_columns].mode().iloc[0]

# Standard deviation
std_values = df[numeric_columns].std()

descriptive_statistics = pd.DataFrame({
    "Mean": mean_values,
    "Median": median_values,
    "Mode": mode_values,
    "Standard Deviation": std_values
})

display(descriptive_statistics.round(2))
# %%
# ============================================================
# 12. STANDARD DESCRIPTIVE STATISTICS
# ============================================================

display(df[numeric_columns].describe().round(2))
# %%
# ============================================================
# 13. CUSTOMER AGE GROUPS
# ============================================================

age_bins = [0, 18, 25, 35, 45, 55, 65, 100]

age_labels = [
    "Under 18",
    "18-24",
    "25-34",
    "35-44",
    "45-54",
    "55-64",
    "65+"
]

df["Age Group"] = pd.cut(
    df["Age"],
    bins=age_bins,
    labels=age_labels,
    right=False
)

age_distribution = (
    df["Age Group"]
    .value_counts()
    .reindex(age_labels)
)

display(age_distribution.to_frame(name="Customers"))
# %%
# ============================================================
# 14. AGE GROUP DISTRIBUTION
# ============================================================

plt.figure(figsize=(10, 6))

sns.countplot(
    data=df,
    x="Age Group",
    order=age_labels
)

plt.title("Customer Distribution by Age Group")
plt.xlabel("Age Group")
plt.ylabel("Number of Transactions")
plt.xticks(rotation=30)

plt.tight_layout()
plt.show()
# %% [markdown]
# ### Observation — Customer Age Groups
# 
# The age-group distribution shows which customer segments contribute the largest
# number of transactions.
# 
# The dominant age groups can be targeted with personalized promotions,
# product recommendations and marketing campaigns.
# 
# Age groups with relatively low transaction counts may represent opportunities
# for targeted customer acquisition campaigns.
# %%
# ============================================================
# 15. GENDER DISTRIBUTION
# ============================================================

gender_distribution = df["Gender"].value_counts()

print("Gender Distribution:")
display(gender_distribution.to_frame(name="Transactions"))
# %%
# ============================================================
# 16. GENDER BREAKDOWN
# ============================================================

plt.figure(figsize=(8, 6))

sns.countplot(
    data=df,
    x="Gender",
    order=df["Gender"].value_counts().index
)

plt.title("Customer Transactions by Gender")
plt.xlabel("Gender")
plt.ylabel("Number of Transactions")

plt.tight_layout()
plt.show()
# %% [markdown]
# ### Observation — Gender Breakdown
# 
# The gender distribution indicates whether sales transactions are concentrated
# among one gender or relatively balanced.
# 
# If one group contributes significantly more transactions, marketing campaigns
# can be optimized for that segment while developing targeted strategies to
# increase engagement from underrepresented customer groups.
# %%
# ==========================================================
# 17. MONTHLY SALES TREND
# ==========================================================

# Convert Date to datetime
df["Date"] = pd.to_datetime(df["Date"], errors="coerce")

# Create Year-Month
df["Year-Month"] = df["Date"].dt.to_period("M").astype(str)


# Calculate monthly sales
monthly_sales = (
    df.groupby("Year-Month")["Total Amount"]
      .sum()
      .sort_index()
)

print(monthly_sales)
# %%
# ============================================================
# 18. MONTHLY SALES LINE CHART
# ============================================================

plt.figure(figsize=(14, 6))

plt.plot(
    monthly_sales.index.astype(str),
    monthly_sales.values,
    marker="o"
)

plt.title("Monthly Sales Trend")
plt.xlabel("Month")
plt.ylabel("Total Sales")

plt.xticks(rotation=45)

plt.tight_layout()
plt.show()
# %% [markdown]
# ### Observation — Monthly Sales Trend
# 
# The monthly sales trend reveals how revenue changes throughout the year.
# 
# Periods with unusually high sales may indicate seasonal demand, promotional
# activity or increased customer purchasing.
# 
# Low-performing months can be investigated further to determine whether
# discount campaigns, inventory adjustments or targeted promotions could
# improve sales.
# %%
# ============================================================
# 19. QUARTERLY SALES
# ============================================================

df["Quarter"] = "Q" + df["Date"].dt.quarter.astype(str)

quarterly_sales = (
    df.groupby(["Year", "Quarter"], as_index=False)["Total Amount"]
      .sum()
      .sort_values(["Year", "Quarter"])
)

display(quarterly_sales)
# %%
# ============================================================
# 20. QUARTERLY SALES LINE CHART
# ============================================================

quarterly_sales["Quarter Label"] = (
    quarterly_sales["Year"].astype(str)
    + "-"
    + quarterly_sales["Quarter"]
)

plt.figure(figsize=(10, 6))

plt.plot(
    quarterly_sales["Quarter Label"],
    quarterly_sales["Total Amount"],
    marker="o"
)

plt.title("Quarterly Sales Trend")
plt.xlabel("Quarter")
plt.ylabel("Total Sales")

plt.xticks(rotation=30)

plt.tight_layout()
plt.show()
# %% [markdown]
# ### Observation — Quarterly Sales Trend
# 
# Quarterly aggregation makes broader seasonal patterns easier to identify than
# daily or monthly analysis.
# 
# The strongest quarter represents the period with the greatest revenue
# contribution. Management can use this information to prepare inventory,
# marketing campaigns and staffing levels ahead of high-demand periods.
# %%
# ============================================================
# 21. TOP 10 BEST-SELLING PRODUCTS / CATEGORIES
# ============================================================

top_products = (
    df.groupby("Product Category")["Quantity"]
    .sum()
    .sort_values(ascending=False)
    .head(10)
)

print("Top-selling product categories by quantity:")
display(top_products.to_frame(name="Total Quantity Sold"))
# %%
# ============================================================
# 22. TOP 10 BEST-SELLING PRODUCTS / CATEGORIES
# ============================================================

plt.figure(figsize=(10, 6))

sns.barplot(
    x=top_products.values,
    y=top_products.index
)

plt.title("Top-Selling Product Categories by Quantity")
plt.xlabel("Quantity Sold")
plt.ylabel("Product Category")

plt.tight_layout()
plt.show()
# %% [markdown]
# ### Observation — Best-Selling Products
# 
# The ranking identifies the product categories generating the greatest sales
# volume.
# 
# High-volume categories should receive appropriate inventory priority because
# stock-outs in these categories can directly affect sales.
# 
# However, quantity sold should be considered together with revenue and price
# before making inventory decisions.
# %%
# ============================================================
# 23. REVENUE BY PRODUCT CATEGORY
# ============================================================

category_revenue = (
    df.groupby("Product Category")["Total Amount"]
    .sum()
    .sort_values(ascending=False)
)

display(category_revenue.to_frame(name="Revenue"))
# %%
# ============================================================
# 24. REVENUE BY PRODUCT CATEGORY
# ============================================================

plt.figure(figsize=(10, 6))

sns.barplot(
    x=category_revenue.values,
    y=category_revenue.index
)

plt.title("Revenue by Product Category")
plt.xlabel("Total Revenue")
plt.ylabel("Product Category")

plt.tight_layout()
plt.show()
# %% [markdown]
# ### Observation — Revenue by Product Category
# 
# Revenue contribution may differ from sales volume because categories can have
# different average selling prices.
# 
# A category with fewer transactions can still generate substantial revenue if
# its products have higher prices.
# 
# Therefore, business decisions should consider both quantity sold and revenue
# contribution.
# %%
# ============================================================
# 25. CORRELATION MATRIX
# ============================================================

correlation_columns = [
    "Age",
    "Quantity",
    "Price per Unit",
    "Total Amount"
]

correlation_matrix = df[correlation_columns].corr()

display(correlation_matrix.round(2))
# %%
# ============================================================
# 26. CORRELATION HEATMAP
# ============================================================

plt.figure(figsize=(9, 7))

sns.heatmap(
    correlation_matrix,
    annot=True,
    cmap="coolwarm",
    fmt=".2f",
    linewidths=0.5
)

plt.title("Correlation Matrix of Numerical Variables")

plt.tight_layout()
plt.show()
# %% [markdown]
# ### Observation — Correlation Analysis
# 
# The correlation matrix shows the strength and direction of relationships
# between numerical variables.
# 
# In particular, the relationship between Quantity, Price per Unit and
# Total Amount is useful for understanding the mechanics of revenue generation.
# 
# A strong positive relationship between Quantity and Total Amount would indicate
# that transaction value is strongly influenced by the number of units purchased.
# 
# Correlation should not be interpreted as proof of causation.
# %%
# ============================================================
# 27. ADDITIONAL INSIGHT:
#     AVERAGE TRANSACTION VALUE BY AGE GROUP
# ============================================================

avg_transaction_age = (
    df.groupby("Age Group", observed=True)["Total Amount"]
    .mean()
    .reindex(age_labels)
)

display(
    avg_transaction_age
    .to_frame(name="Average Transaction Value")
    .round(2)
)
# %%
# ============================================================
# 28. AVERAGE TRANSACTION VALUE BY AGE GROUP
# ============================================================

plt.figure(figsize=(10, 6))

sns.barplot(
    x=avg_transaction_age.index,
    y=avg_transaction_age.values
)

plt.title("Average Transaction Value by Customer Age Group")
plt.xlabel("Age Group")
plt.ylabel("Average Transaction Value")

plt.xticks(rotation=30)

plt.tight_layout()
plt.show()
# %% [markdown]
# ### Observation — Non-Obvious Customer Insight
# 
# The age group with the highest number of transactions is not necessarily
# the age group with the highest average transaction value.
# 
# This distinction is important because customer volume and customer value are
# different business metrics.
# 
# A smaller customer segment with a higher average transaction value could be
# particularly attractive for premium-product marketing, loyalty programs and
# personalized offers.
# %%
# ============================================================
# 29. REVENUE BY GENDER
# ============================================================

gender_revenue = (
    df.groupby("Gender")["Total Amount"]
    .agg(["sum", "mean", "count"])
    .rename(columns={
        "sum": "Total Revenue",
        "mean": "Average Transaction Value",
        "count": "Transactions"
    })
)

display(gender_revenue.round(2))
# %%
# ============================================================
# 30. REVENUE BY GENDER
# ============================================================

plt.figure(figsize=(8, 6))

sns.barplot(
    data=gender_revenue.reset_index(),
    x="Gender",
    y="Total Revenue"
)

plt.title("Total Revenue by Gender")
plt.xlabel("Gender")
plt.ylabel("Total Revenue")

plt.tight_layout()
plt.show()
# %% [markdown]
# ### Observation — Gender Revenue
# 
# Revenue by gender provides more information than transaction counts alone.
# 
# Comparing transaction volume with total revenue and average transaction value
# helps determine whether differences in customer behaviour are driven by the
# number of customers or by the amount spent per transaction.
# %%
# ============================================================
# 31. KEY BUSINESS KPIs
# ============================================================

total_revenue = df["Total Amount"].sum()
total_quantity = df["Quantity"].sum()
total_transactions = df["Transaction ID"].nunique()
average_transaction = df["Total Amount"].mean()
median_transaction = df["Total Amount"].median()
average_price = df["Price per Unit"].mean()

print("=" * 60)
print("KEY BUSINESS KPIs")
print("=" * 60)

print(f"Total Revenue             : {total_revenue:,.2f}")
print(f"Total Quantity Sold       : {total_quantity:,.0f}")
print(f"Total Transactions        : {total_transactions:,.0f}")
print(f"Average Transaction Value : {average_transaction:,.2f}")
print(f"Median Transaction Value  : {median_transaction:,.2f}")
print(f"Average Price per Unit    : {average_price:,.2f}")
# %%
# ============================================================
# 32. BEST AND WORST SALES MONTH
# ============================================================

best_month = monthly_sales.idxmax()
best_month_sales = monthly_sales.max()

worst_month = monthly_sales.idxmin()
worst_month_sales = monthly_sales.min()

print("Best Sales Month:")
print(f"{best_month} -> {best_month_sales:,.2f}")

print("\nLowest Sales Month:")
print(f"{worst_month} -> {worst_month_sales:,.2f}")
# %%
# ============================================================
# 33. BEST PRODUCT CATEGORY
# ============================================================

best_category = category_revenue.idxmax()
best_category_revenue = category_revenue.max()

print(f"Highest Revenue Category: {best_category}")
print(f"Revenue: {best_category_revenue:,.2f}")
# %% [markdown]
# # Conclusion
# 
# ## Key Findings
# 
# The exploratory analysis of the retail sales dataset provides insights into
# sales trends, customer demographics and product performance.
# 
# ### 1. Sales Trend
# 
# Monthly and quarterly analysis helps identify periods of high and low demand.
# The business can use these patterns for inventory planning, staffing and
# marketing campaigns.
# 
# ### 2. Customer Behaviour
# 
# Age-group and gender analysis shows how different customer segments contribute
# to transaction volume and revenue.
# 
# Importantly, the customer segment with the largest number of transactions is
# not necessarily the segment with the highest average transaction value.
# 
# ### 3. Product Performance
# 
# Product-category analysis highlights the categories contributing the most
# quantity sold and revenue.
# 
# Quantity and revenue should be analyzed together because high-volume products
# are not always the highest-value products.
# 
# ### 4. Numerical Relationships
# 
# Correlation analysis helps identify relationships between age, quantity,
# price and transaction amount.
# 
# The relationship between quantity and total transaction value is particularly
# important for understanding purchasing behaviour.
# 
# ---
# 
# # Actionable Business Recommendations
# 
# ## Recommendation 1 — Target High-Value Customer Segments
# 
# Identify age groups with high average transaction values and create targeted
# marketing campaigns, premium offers and loyalty programs for these customers.
# 
# ## Recommendation 2 — Optimize Inventory Using Sales Trends
# 
# Use monthly and quarterly sales patterns to forecast demand and maintain
# higher inventory levels before peak sales periods while reducing excess
# inventory during low-demand periods.
# 
# ## Recommendation 3 — Prioritize High-Revenue Product Categories
# 
# Allocate inventory, marketing budget and promotional resources toward categories
# that consistently generate high revenue.
# 
# ## Recommendation 4 — Increase Average Transaction Value
# 
# For high-volume but relatively low-value categories, introduce product bundles,
# cross-selling and upselling offers to increase the average transaction value.
# 
# ## Recommendation 5 — Personalize Marketing
# 
# Use customer demographic information such as age group and gender together
# with purchasing behaviour to develop more targeted promotional campaigns.
# 
# ---
# 
